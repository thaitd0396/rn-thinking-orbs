{
  "name": "rn-thinking-orbs",
  "version": "0.1.6",
  "description": "Native dotted thinking-orbs view for React Native (Metal on iOS, AGSL on Android)",
  "homepage": "https://github.com/thaitd0396/rn-thinking-orbs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaitd0396/rn-thinking-orbs.git"
  },
  "bugs": {
    "url": "https://github.com/thaitd0396/rn-thinking-orbs/issues"
  },
  "main": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "types": "./src/index.tsx",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "!android/build",
    "!ios/build",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android",
    "thinking-orbs"
  ],
  "license": "MIT",
  "author": "thaitd <thaitranbk59@gmail.com> (https://github.com/thaitd0396)",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "RnThinkingOrbsSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnthinkingorbs"
    },
    "ios": {
      "componentProvider": {
        "RnThinkingOrbsView": "RnThinkingOrbsView"
      }
    }
  }
}
